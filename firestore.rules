rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDayData(data) {
      return data.userId is string 
        && data.userId == request.auth.uid
        && data.date is string 
        && data.date.size() <= 10 
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('dayNotes' in data) || (data.dayNotes is string && data.dayNotes.size() <= 2000))
        && (!('waterLogs' in data) || (data.waterLogs is list && data.waterLogs.size() <= 100))
        && (!('mealLogs' in data) || (data.mealLogs is list && data.mealLogs.size() <= 100))
        && (!('restroomLogs' in data) || (data.restroomLogs is list && data.restroomLogs.size() <= 100))
        && (!('activityLogs' in data) || (data.activityLogs is list && data.activityLogs.size() <= 100));
    }

    // User profile documents
    match /users/{userId} {
      allow get, create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // User daily tracking logs
      match /days/{dateKey} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) 
          && isValidId(userId) 
          && isValidId(dateKey) 
          && isValidDayData(incoming());
        allow update: if isOwner(userId) 
          && isValidId(userId) 
          && isValidId(dateKey) 
          && isValidDayData(incoming()) 
          && incoming().userId == existing().userId 
          && incoming().date == existing().date;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(dateKey);
      }
    }
  }
}
